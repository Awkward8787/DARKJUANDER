# dj-base
# Fedora bootc 45 index digest resolved on 2026-10-28. The tag is kept so the
# line stays readable; the digest is what the build uses. CI builds this
# image. It has not been booted, and it is not signed.
FROM quay.io/fedora/fedora-bootc:45@sha256:ed6ebf922c4c63704b1ff7befff74c8d06a5fb74a37b817df3d2cd093568bbc5

ARG DJ_VERSION=0.1.0

# plymouth-plugin-script provides script.so. plymouth-plugin-label provides
# label.so (Image.Text). plymouth-scripts provides plymouth-set-default-theme.
# generic-logos replaces Fedora's marks. fonttools, pillow, and librsvg are
# removed after the assets are generated.
RUN dnf -y install --setopt=install_weak_deps=False \
      bubblewrap \
      nftables \
      policycoreutils \
      jq \
      stress-ng \
      openssl \
      ca-certificates \
      plymouth \
      plymouth-scripts \
      plymouth-plugin-script \
      plymouth-plugin-label \
      fontconfig \
      hicolor-icon-theme \
      python3-fonttools \
      python3-pillow \
      librsvg2-tools \
    && dnf -y swap fedora-logos generic-logos \
    && dnf clean all

# BASE-6: do not listen on the network by default. sshd is disabled when the
# base image ships the unit. BASE-8: mask the rpm-ostree count-me timer when present.
RUN if [ -f /usr/lib/systemd/system/sshd.service ]; then systemctl disable sshd.service; fi \
    && if [ -f /usr/lib/systemd/system/rpm-ostree-countme.timer ]; then systemctl mask rpm-ostree-countme.timer; fi \
    && if [ -f /usr/lib/systemd/system/rpm-ostree-countme.service ]; then systemctl mask rpm-ostree-countme.service; fi

COPY out/stage/umbrad /usr/bin/umbrad
COPY out/stage/dj /usr/bin/dj
COPY out/stage/dj-auditd /usr/bin/dj-auditd
COPY policy/default.yaml /usr/share/darkjuander/policy/default.yaml
COPY examples/config/umbrad.yaml /etc/darkjuander/umbrad.yaml
COPY image/systemd/ /usr/lib/systemd/system/
COPY image/sysctl.d/90-darkjuander.conf /usr/lib/sysctl.d/90-darkjuander.conf
COPY image/nftables.conf /etc/sysconfig/nftables.conf
COPY image/sysusers.d/darkjuander.conf /usr/lib/sysusers.d/darkjuander.conf
COPY image/tmpfiles.d/darkjuander.conf /usr/lib/tmpfiles.d/darkjuander.conf
COPY image/selinux/ /usr/share/darkjuander/selinux/

# Generate OS rasters from the SVG sources, then install them. GRUB art stays
# in this tree and is not copied into a bootloader path. bootupd does not
# read a GRUB theme. None of this has been booted.
COPY branding /tmp/darkjuander-branding
COPY image/dracut/darkjuander-plymouth.conf /usr/lib/dracut/dracut.conf.d/darkjuander-plymouth.conf
COPY image/bootc/10-darkjuander.toml /usr/lib/bootc/kargs.d/10-darkjuander.toml
COPY image/backgrounds/darkjuander.xml /usr/share/gnome-background-properties/darkjuander.xml
COPY image/fontconfig/50-darkjuander-inter.conf /usr/share/fontconfig/conf.avail/50-darkjuander-inter.conf
COPY image/apply-branding.sh /tmp/apply-branding.sh
COPY image/check-initramfs.sh /usr/libexec/darkjuander/check-initramfs.sh

RUN ln -sfn /usr/share/fontconfig/conf.avail/50-darkjuander-inter.conf /etc/fonts/conf.d/50-darkjuander-inter.conf \
    && python3 /tmp/darkjuander-branding/scripts/build.py --only os \
    && mkdir -p /usr/share/plymouth/themes /usr/share/backgrounds /usr/share/icons /usr/share/fonts /usr/share/darkjuander \
    && cp -aL /tmp/darkjuander-branding/plymouth/darkjuander /usr/share/plymouth/themes/darkjuander \
    && cp -aL /tmp/darkjuander-branding/wallpapers /usr/share/backgrounds/darkjuander \
    && cp -aL /tmp/darkjuander-branding/os-icon/hicolor/. /usr/share/icons/hicolor/ \
    && cp -aL /tmp/darkjuander-branding/src/fonts/. /usr/share/fonts/darkjuander/ \
    && cp -aL /tmp/darkjuander-branding/terminal /usr/share/darkjuander/terminal \
    && rm -rf /usr/share/fonts/darkjuander/.instances \
    && systemctl enable dj-auditd.service umbrad.service nftables.service \
    && bash /tmp/apply-branding.sh \
    && rm -f /tmp/apply-branding.sh \
    && fc-cache -f

# Replace the base initramfs. bootc-image-builder does not rebuild it.
# check-initramfs.sh requires the theme script path, Theme=darkjuander inside
# the initramfs plymouthd.conf, Plymouth.ttf pointing at Inter, and a size
# at or under 140 MiB. A bare "darkjuander" match is not that check.
# UseSimpledrm=1 is appended to plymouthd.defaults because the plymouth
# dracut module reads that file, not /etc, when hostonly is off. simpledrm
# is built into the Fedora kernel. UEFI firmware framebuffers (UTM) still
# work. The full drm module was pulling in about 100 MB of nvidia firmware.
# This choice has not been booted.
RUN grep -q '^UseSimpledrm=' /usr/share/plymouth/plymouthd.defaults \
    || printf '\nUseSimpledrm=1\n' >> /usr/share/plymouth/plymouthd.defaults \
    && kver=$(ls -1 /usr/lib/modules) \
    && test "$(printf '%s\n' "$kver" | wc -l)" -eq 1 \
    && DRACUT_NO_XATTR=1 dracut --force "/usr/lib/modules/${kver}/initramfs.img" "${kver}" \
    && bash /usr/libexec/darkjuander/check-initramfs.sh

RUN dnf -y remove --setopt=clean_requirements_on_remove=True \
      python3-fonttools \
      python3-pillow \
      librsvg2-tools \
    && dnf -y clean all \
    && rm -rf /tmp/darkjuander-branding

# Apache-2.0 is the project code. Brand marks are proprietary
# (branding/LICENSE-BRAND.md). The OFL fonts keep their own licenses.
# Fedora packages keep theirs. This image has not been booted.
LABEL org.opencontainers.image.title="dj-base" \
      org.opencontainers.image.description="DARKJUANDER hardened bootc image definition. Not booted. Not signed." \
      org.opencontainers.image.version="${DJ_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0 AND OFL-1.1 AND LicenseRef-DARKJUANDER-Brand" \
      org.opencontainers.image.source="https://github.com/Awkward8787/DARKJUANDER" \
      org.darkjuander.status="not-booted"
