[Unit]
Description=DARKJUANDER UMBRA neural core
After=local-fs.target
# The whole daemon sits in the shared weights slice. Per-request cgroup
# migration into the caller's cgroup is planned and not implemented.
Slice=umbra-weights.slice

[Service]
Type=simple
User=dj-umbra
Group=dj-umbra
ExecStart=/usr/bin/umbrad --config /etc/darkjuander/umbrad.yaml
RuntimeDirectory=darkjuander
StateDirectory=darkjuander
RuntimeDirectoryMode=0750
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
ReadWritePaths=/var/lib/darkjuander /run/darkjuander

[Install]
WantedBy=multi-user.target
