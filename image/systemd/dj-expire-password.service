[Unit]
Description=Expire the published dj console password on first boot
After=local-fs.target
Before=systemd-user-sessions.service
ConditionPathExists=!/var/lib/darkjuander/dj-password-expired

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'chage -d 0 dj && mkdir -p /var/lib/darkjuander && touch /var/lib/darkjuander/dj-password-expired'

[Install]
WantedBy=multi-user.target
